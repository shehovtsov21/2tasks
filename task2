<!DOCTYPE html>

<html lang="ru" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title>My To Do List</title>
    <style type="text/css">
        body {
            font-family: Calibri, sans-serif;
            background-color: #f4f4f4;
        }

        .todo-container {
            width: 450px;
            margin: 30px auto;
            background-color: #ffffff;
            padding: 20px;
            border: 1px solid #dddddd;
        }

        h2 {
            text-align: left;
            color: #000000;
            margin-top: 0;
            font-size: 20pt;
        }

        ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        li {
            padding: 10px 15px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        li:nth-child(odd) {
            background-color: #c9e1ed;
        }

        li:nth-child(even) {
            background-color: #e1edf2;
        }

        li.checked {
            background-color: #e2e2e2 !important;
            text-decoration: line-through;
            color: #333333;
        }

        .task-text {
            flex-grow: 1;
            margin-left: 10px;
        }

        .checkbox {
            font-size: 14pt;
        }

        .delete-btn {
            color: #cc0000;
            font-weight: bold;
            font-size: 14pt;
        }
    </style>
</head>
<body>
    <div class="todo-container">
        <h2>My To Do List</h2>
        <ul>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Hit the gym</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li class="checked">
                <span class="checkbox">&#9745;</span>
                <span class="task-text">Pay bills</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Meet John</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Buy eggs</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li class="checked">
                <span class="checkbox">&#9745;</span>
                <span class="task-text">Read a book</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Organize office</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Eat dinner</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Buy apples</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Meet George</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Feed the cat</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li class="checked">
                <span class="checkbox">&#9745;</span>
                <span class="task-text">Write a letter</span>
                <span class="delete-btn">&times;</span>
            </li>
            <li>
                <span class="checkbox">&#9744;</span>
                <span class="task-text">Run 1 km</span>
                <span class="delete-btn">&times;</span>
            </li>
        </ul>
    </div>
</body>
</html>
